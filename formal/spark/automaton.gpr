project Automaton_Proof_Lab is
   for Source_Dirs use (".");
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("automaton_cli.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;
end Automaton_Proof_Lab;
