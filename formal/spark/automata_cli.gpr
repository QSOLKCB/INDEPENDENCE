project Automata_CLI is
   for Source_Dirs use (".");
   for Create_Missing_Dirs use "True";
   for Object_Dir use "automata_cli_obj";
   for Exec_Dir use "automata_bin";
   for Main use ("automata_cli.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata");
   end Compiler;
end Automata_CLI;
